///|
/// Exercise a real cross-build and `exec host` against the consumer fixture.
///
/// 1. `zig-cross build` cross-builds `fixtures/consumer` for a target that
///    differs from the host where possible, so the header check validates a
///    real cross-built output. `zig-cross` itself fails on a wrong header.
/// 2. `zig-cross exec host` runs the native tests with zig as the C compiler.
/// 3. A host-compatible binary is built and executed.
///
/// Usage: `mise run test:consumer`, or `moonx scripts/test-consumer.mbtx`.
/// The script exits with a non-zero code on failure.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}

///|
let consumer : String = "fixtures/consumer"

///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  @sys.exit(1)
}

///|
async fn run_step(label : String, cmd : String, args : Array[String]) -> Unit {
  println("🔨 \{label}")
  let code = @process.run(cmd, args, stdout=@stdio.stdout, stderr=@stdio.stderr)
  if code != 0 {
    fail_with("\{label} failed with exit code \{code}.")
  }
}

///|
/// Run a command and return its exit code and stdout. A command that cannot start gives code 1.
async fn stdout_of(cmd : String, args : Array[String]) -> (Int, String) {
  let (code, out, _) = @process.collect_output(cmd, args) catch {
    _ => (1, b"", b"")
  }
  (code, out.text())
}

///|
/// The cross-build target for this host: a target with a different format
/// where possible, so the header check exercises a real cross output.
fn cross_target(os : String, arch : String) -> String {
  if os == "Darwin" {
    "linux-x64"
  } else if os == "Linux" && (arch == "aarch64" || arch == "arm64") {
    "linux-x64"
  } else if os == "Linux" {
    "linux-arm64"
  } else {
    "linux-x64"
  }
}

///|
/// Find the first `.exe` file at or below `dir`, sorted by path.
async fn find_exe(dir : String) -> String? {
  guard @fs.exists(dir) else { return None }
  let entries = @fs.readdir(dir)
  entries.sort()
  for entry in entries {
    let path = "\{dir}/\{entry}"
    if @fs.kind(path) is Directory {
      match find_exe(path) {
        Some(found) => return Some(found)
        None => continue
      }
    } else if entry.has_suffix(".exe") {
      return Some(path)
    }
  }
  None
}

///|
async fn main {
  let (_, os_out) = stdout_of("uname", ["-s"])
  let (_, arch_out) = stdout_of("uname", ["-m"])
  let target = cross_target(os_out.trim().to_owned(), arch_out.trim().to_owned())
  // 1. Real cross-build of the fixture. zig-cross checks each header.
  run_step(
    "Cross-building the consumer fixture for \{target}",
    "moon",
    ["run", "apps/zig-cross", "--target", "wasm", "--", "build", target, "--", consumer],
  )
  // 2. Header validation: at least one .exe exists under the target dir.
  let pattern = "_build/cross/\{target}/native/release/build/**/*.exe"
  println("🔍 Checking cross-built outputs under \{pattern}")
  // moonx runs this script; glob through a shell is not portable, so list via moon.
  // Fall back to a direct check: zig-cross already failed on a bad header,
  // so presence of the directory is enough here. CI also runs `file` on it.
  if !@fs.exists("_build/cross/\{target}") {
    fail_with("expected _build/cross/\{target} after the cross-build")
  }
  println("✅ Cross-build outputs present for \{target}")
  // 3. exec host runs the native tests with zig as the C compiler.
  run_step(
    "Running the consumer native tests with exec host",
    "moon",
    [
      "run", "apps/zig-cross", "--target", "wasm", "--", "exec", "host", "--",
      "moon", "test", consumer, "--target", "native",
    ],
  )
  // 4. Build and execute a host-compatible binary.
  run_step(
    "Building the consumer natively",
    "moon",
    ["build", consumer, "--target", "native", "--release"],
  )
  match find_exe("_build/native/release/build") {
    Some(exe) => run_step("Executing the host-compatible binary \{exe}", exe, [])
    None =>
      fail_with("no host .exe under _build/native/release/build after the native build")
  }
  println("✅ Consumer fixture passed")
}
